# Copie ce fichier en .env puis remplis-le. Ne le publie jamais.
PORT=3000
DB_FILE=./data/prepconcours.db

# Obligatoires : 16 caractères minimum, aléatoires (ex. : openssl rand -hex 32)
SERVER_SECRET=
ADMIN_TOKEN=

# Codes administrateur : génère-les avec « node scripts/admin-code.js 2 » (ex. T68K-NXHR-QQ3Z,J9HF-5ZRZ-LD9X).
# Les empreintes correspondantes doivent être dans l'application (ADMIN_HASHES dans data.js).
ADMIN_CODES=

# Assistant IA : gemini | openai | anthropic
AI_PROVIDER=gemini
AI_KEY=
AI_MODEL=
USE_WEB=0
MAX_PAR_APPAREIL=25
MAX_GLOBAL=800

# E-mails d'activation (compte gratuit sur https://resend.com). Sans clé : le code s'affiche seulement dans les journaux.
RESEND_API_KEY=
MAIL_FROM=PREP' CONCOURS BF <onboarding@resend.dev>

# Derrière un proxy HTTPS (Render, Railway, Nginx, Caddy…) : 1
TRUST_PROXY=1
CORS_ORIGIN=*
